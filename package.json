{
  "name": "expo-sqlite-migrate",
  "version": "0.0.1",
  "description": "lightweight React Native and Expo migrations library",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "react-native": "dist/index.js",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "test": "vitest",
    "build": "tsdown src/index.ts --format cjs,esm --dts --clean --platform neutral --external react,react-native"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Badrchanaa/expo-sqlite-migrate.git"
  },
  "keywords": [
    "sqlite",
    "react-native",
    "expo",
    "migration"
  ],
  "author": "Badr Chanaa",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Badrchanaa/expo-sqlite-migrate/issues"
  },
  "homepage": "https://github.com/Badrchanaa/expo-sqlite-migrate#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.17",
    "expo-sqlite": "^16.0.10",
    "sqlite3": "^5.1.7",
    "tsdown": "^0.19.0",
    "tsx": "^4.21.0",
    "vitest": "^4.0.17"
  },
  "peerDependencies": {
    "expo-sqlite": "^16.0.10",
    "sqlite3": "^5.1.7"
  },
  "peerDependenciesMeta": {
    "expo-sqlite": {
      "optional": true
    },
    "sqlite3": {
      "optional": true
    }
  },
  "overrides": {
    "tar": "7.5.3"
  }
}
